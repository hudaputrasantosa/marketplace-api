# App
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:8080

# Auth
SECRET_KEY=change-me
REFRESH_SECRET_KEY=change-me-too
JWT_EXPIRES_IN=1h

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=db_market
DB_POOL_SIZE=10
# Set to true to log every SQL query to the console/Pino (debugging only).
DB_LOG_QUERIES=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
# Browser-facing management UI, shown in the startup banner (differs from RABBITMQ_URL's host
# inside Docker).
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=5 minutes
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=5 minutes

# GlitchTip (Sentry-compatible) error capturing - leave empty to disable
GLITCHTIP_DSN=

# OpenTelemetry - disabled by default, for future Grafana/Tempo integration
OTEL_ENABLED=false
OTEL_SERVICE_NAME=marketplace-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Background jobs
MONTHLY_REPORT_CRON=0 0 1 * *

# HTTP Basic Auth credentials for the Bull Board UI (/api/admin/queues) - change these in
# production.
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin

# Commit shown in the startup banner - set by the Docker build (falls back to a live
# `git rev-parse` locally, then "unknown"). Leave empty for local dev.
GIT_COMMIT_SHA=
